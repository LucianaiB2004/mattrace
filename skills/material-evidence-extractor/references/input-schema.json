{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattrace.local/schemas/material-evidence-input.json",
  "title": "Material Evidence Extractor Input",
  "type": "object",
  "required": ["documents"],
  "additionalProperties": false,
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["document_id", "name", "document_type", "pages"],
        "additionalProperties": false,
        "properties": {
          "document_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "document_type": { "enum": ["paper", "patent", "tds"] },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["page", "text"],
              "properties": {
                "page": { "type": ["integer", "string"] },
                "text": { "type": "string" },
                "source_kind": { "enum": ["body", "abstract", "table", "figure_caption", "footnote", "ocr"] }
              }
            }
          }
        }
      }
    }
  }
}
